{
  "name": "@psmfd/pi-workflow",
  "version": "0.0.0-development",
  "description": "Deterministic typed workflow extension for pi",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "workflow",
    "code-review"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts eslint.config.js --max-warnings 0",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.worktrees\"",
    "validate:workflows": "node scripts/validate-workflows.mjs",
    "security:dependencies": "node scripts/check-dependency-policy.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security": "npm run security:dependencies && npm run security:secrets && npm audit --audit-level=critical && npm audit --omit=dev",
    "check": "npm run typecheck && npm run lint && npm run lint:docs && npm test && npm run validate:workflows && npm run security:dependencies && npm run security:secrets",
    "smoke:pi": "tsx test/smoke-package.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "eslint-plugin-security": "4.0.1",
    "globals": "15.14.0",
    "markdownlint-cli2": "0.23.1",
    "tsx": "4.23.1",
    "typebox": "1.1.38",
    "typescript": "5.6.3",
    "typescript-eslint": "8.19.1",
    "yaml": "2.9.0"
  }
}
